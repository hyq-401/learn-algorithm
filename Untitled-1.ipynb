   "source": [
    "class Solution(object):\n",
    "    def isAnagram(self, s: str, t: str) -> bool:\n",
    "        from collections import Counter\n",
    "        a_count = Counter(s)\n",
    "        b_count = Counter(t)\n",
    "        return a_count == b_count"
   ]
  }
